{application, glazer,
 [{description, "Erlang NIF JSON encoder/decoder using the glaze C++ library"},
  {vsn, "1.1.1"},
  {registered, []},
  {applications, [kernel, stdlib]},
  {env, [
    %% Atom to use for JSON null, e.g. null or nil
    {null, null}
  ]},
  {modules,  [glazer]},
  {licenses, ["MIT"]},
  {links,    [{"GitHub", "https://github.com/saleyn/glazer"}]},
  {files,    [
    "src", "c_src", "lib", "Makefile", "rebar.config", "mix.exs", "mix.lock", "rebar.lock",
    "README.md", "LICENSE", "assets"
  ]}
 ]}.
