{application, glazer,
 [{description, "Erlang and Elixir NIF library for JSON, YAML and CSV, with JSON Schema 2020-12 validation"},
  {vsn, "1.2.2"},
  {registered, []},
  {applications, [kernel, stdlib]},
  {env, [
    %% Atom to use for JSON null, e.g. null or nil
    {null, null}
  ]},
  {modules,  [glazer]},
  {licenses, ["MIT"]},
  {links,    [{"GitHub", "https://github.com/saleyn/glazer"}]},
  {files,    [
    "src", "bin", "c_src", "lib", "test", "Makefile",
    "rebar.config", "rebar.lock",
    "mix.exs", "mix.lock",
    "README.md", "LICENSE", "assets"
  ]}
 ]}.
