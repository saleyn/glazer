{erl_opts, [
  debug_info,
  warnings_as_errors,
  warn_export_all
]}.

{deps, []}.

{pre_hooks,  [{compile, "make -s nif"}]}.
{post_hooks, [
  {clean,   "rm -f *.dump *.crashdump"}
]}.

{plugins, [rebar3_hex, {rebar3_ex_doc, "0.3.0"}]}.
{hex,     [{doc, ex_doc}]}.

{ex_doc, [
  {extras, [
    {"README.md", #{title => "Overview"}},
    {"LICENSE",   #{title => "License"}}
  ]},
  {main,          "README.md"},
  {source_url,    "https://github.com/saleyn/glazer"},
  {assets, #{"assets" => "assets"}}
]}.

{profiles, [
  {test, [
    {extra_src_dirs, ["test"]}
  ]}
]}.
