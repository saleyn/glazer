{
  "type": "object",
  "required": ["id", "imp", "device"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "device": {
      "type": "object",
      "properties": {
        "carrier": {"type": "string"},
        "connectiontype": {"type": "integer", "minimum": 0, "maximum": 7},
        "devicetype": {"type": "integer", "minimum": 0},
        "geo": {
          "type": "object",
          "properties": {
            "country": {"type": "string", "minLength": 2, "maxLength": 3},
            "lat": {"type": "number", "minimum": -90, "maximum": 90},
            "lon": {"type": "number", "minimum": -180, "maximum": 180},
            "region": {"type": "string"},
            "type": {"type": "integer"},
            "zip": {"type": "string"}
          }
        },
        "ifa": {"type": "string"},
        "ip": {"type": "string"},
        "ipv6": {"type": "string"},
        "language": {"type": "string"},
        "os": {"type": "string"},
        "ua": {"type": "string"}
      }
    },
    "imp": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "bidfloor": {"type": "number", "minimum": 0},
          "banner": {
            "type": "object",
            "properties": {
              "h": {"type": "integer", "minimum": 1},
              "w": {"type": "integer", "minimum": 1},
              "pos": {"type": "integer", "minimum": 0}
            }
          },
          "video": {
            "type": "object",
            "properties": {
              "maxduration": {"type": "integer", "minimum": 0},
              "minduration": {"type": "integer", "minimum": 0},
              "mimes": {"type": "array", "items": {"type": "string"}},
              "placement": {"type": "integer"},
              "protocols": {"type": "array", "items": {"type": "integer"}}
            }
          },
          "pmp": {
            "type": "object",
            "properties": {
              "private_auction": {"type": "integer", "enum": [0, 1]},
              "deals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": {"type": "string"},
                    "bidfloor": {"type": "number", "minimum": 0}
                  }
                }
              }
            }
          }
        }
      }
    },
    "regs": {
      "type": "object",
      "properties": {
        "coppa": {"type": "integer", "enum": [0, 1]}
      }
    },
    "site": {
      "type": "object",
      "properties": {
        "cat": {"type": "array", "items": {"type": "string"}},
        "domain": {"type": "string"},
        "page": {"type": "string"},
        "publisher": {
          "type": "object",
          "properties": {"id": {"type": "string"}}
        },
        "ref": {"type": "string"}
      }
    },
    "user": {
      "type": "object",
      "properties": {
        "buyeruid": {"type": "string"},
        "id": {"type": "string"},
        "ext": {
          "type": "object",
          "properties": {
            "eids": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {"type": "string"},
                  "uids": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id"],
                      "properties": {"id": {"type": "string"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
